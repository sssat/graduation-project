# data-pipeline/config/pipeline.env
# - 공용 튜닝/기본 실행 설정 파일
# - 민감한 값은 넣지 않고, git으로 공유 가능한 값만 관리
# - settings.py에서 이 파일을 먼저 읽고, 이후 .env가 같은 키를 덮어쓴다.

# --------------------------------- 1. 로그 파일 저장 경로 --------------------------------------
# (1) 트렌드 크롤링(run_trend) 실행 로그(JSON) 저장 경로
LOG_DIR_TREND=./src/crawler/trend/logs

# (2) 뉴스 크롤링(run_news) 실행 로그(JSON) 저장 경로
LOG_DIR_NEWS=./src/crawler/news/logs

# (3) 전처리(run_preprocess) 실행 로그(JSON) 저장 경로
LOG_DIR_PREPROCESS=./src/preprocess/logs

# (4) 최종 순위 집계(run_final_rank) 실행 로그(JSON) 저장 경로
LOG_DIR_FINAL_RANK=./src/analyzer/final_rank/logs

# (5) 키워드 통계(run_aggregate) 실행 로그(JSON) 저장 경로
LOG_DIR_AGGREGATE=./src/analyzer/aggregate/logs

# (6) 네이버 데이터랩 타임라인 실행 로그(JSON) 저장 경로
LOG_DIR_SEARCH_TIMELINE=./src/analyzer/search_timeline/logs

# (7) AI 요약 (run_summary) 실행 로그(JSON) 저장 경로
LOG_DIR_SUMMARY=./src/analyzer/summary/logs

# (8)-1 제목 감성분석(run_title_sentiment) 실행 로그(JSON) 저장 경로
LOG_DIR_SENTIMENT_TITLE=./src/analyzer/sentiment/title/logs

# (8)-2 본문 감성분석(run_content_sentiment) 실행 로그(JSON) 저장 경로
LOG_DIR_SENTIMENT_CONTENT=./src/analyzer/sentiment/content/logs

# (9)-1 제목 편향분석(run_title_bias) 실행 로그(JSON) 저장 경로
LOG_DIR_BIAS_TITLE=./src/analyzer/bias/title/logs

# (9)-2 본문 편향분석(run_content_bias) 실행 로그(JSON) 저장 경로
LOG_DIR_BIAS_CONTENT=./src/analyzer/bias/content/logs

# (10) 워드클라우드(run_wordcloud) 실행 로그(JSON) 저장 경로
LOG_DIR_WORDCLOUD=./src/analyzer/wordcloud/logs

# (11) 공동언급네트워크(run_cooc_network) 실행 로그(JSON) 저장 경로
LOG_DIR_COOC_NETWORK=./src/analyzer/cooc_network/logs

# --------------------------------- 2. 크롤링(구글 트렌드/네이버 뉴스) 관련 설정 --------------------------------------
# (1) 크롤링 전체 설정
# Selenium 실행 모드(1=헤드리스, 0=브라우저 표시)
HEADLESS=1

# Selenium 대기 시간(초) -> 최대 30초까지 가다리고 그 전에 끝나면 넘어감
SELENIUM_WAIT_SECONDS=30

# (2) 구글 트렌드 실검 크롤링 설정
# Google Trends 크롤링 대상 URL
TRENDS_URL=https://trends.google.com/trending?geo=KR&hours=168&sort=search-volume

# 몇 개의 실시간 검색어를 크롤링 할것인지
# 20으로 설정해도 실검 개수가 17개 밖에 안되면 17개만 크롤링됨
TREND_TOP_N=20

# 오래된 TREND_RUN 정리: 최근 N회차만 유지
# T_TREND_RUN 테이블의 데이터가 삭제되면 이것과 CASCADE로 연결된 테이블의 데이터들도 함께 삭제된다.
RETENTION_KEEP_LAST_N=15

# (3) 네이버 뉴스 크롤링 설정
#   0) 네이버 뉴스 공통 크롤링 설정
# 뉴스 크롤링에 사용할 키워드 상위 N개 -> 구글 트렌드 순위 기준
# 0이면 이번 run의 모든 키워드를 대상으로 크롤링 한다는 의미
NEWS_KEYWORD_TOP_N=0

# run_news 기본 대상 TREND_RUN_SEQ (0이면 최신 자동)
NEWS_TREND_RUN_SEQ=0

# run_news에서 같은 trend_run 재실행 시 삭제 후 재삽입 여부
# 0이면 재삽입 X, 1이면 재삽입 O
NEWS_REFRESH_SAME_RUN=1

# (선택) run_news 기준일 강제 지정(YYYY-MM-DD)
# 미설정 시 run_trend의 BASE_DATE를 DB에서 읽어 사용
# NEWS_BASE_DATE=2026-01-14

# 뉴스 검색 기간(오늘 기준 N일 전까지 포함)
NEWS_DAYS_BACK=14

# 네이버 뉴스 검색 시작 페이지
NEWS_START_PAGE=1

# 네이버 뉴스 검색 끝 페이지
NEWS_END_PAGE=4

# 조회 쿼리에서 WHERE keyword_seq IN (...) 같은 IN 절을 만들 때, IN 안에 넣는 ID 개수를 최대 500개로 쪼개서 조회
KEYWORD_IN_QUERY_BATCH_SIZE=500

# 뉴스 기사 본문 수집 동시성(코루틴 워커 수)
NEWS_ARTICLE_CONCURRENCY=20

# aiohttp 전체 커넥션 제한
NEWS_HTTP_CONN_LIMIT=80

# aiohttp 호스트당 커넥션 제한
NEWS_HTTP_CONN_LIMIT_PER_HOST=20

# (3)-1 네이버 뉴스 제목/본문 크롤링 설정
# (멀티프로세스) 제목/본문 링크 수집 프로세스 수
NEWS_SEARCH_PROCESSES=3

# 기사를 DB에 저장할 때 한 번에 400개씩 저장
ARTICLE_UPSERT_BATCH_SIZE=400

# (3)-2 네이버 뉴스 댓글 크롤링 설정
# 댓글 크롤러 실행 여부(1=실행, 0=미실행)
INCLUDE_COMMENTS=1

# (멀티프로세스) 댓글 수집 프로세스 수
NEWS_COMMENT_PROCESSES=3

# 기사 1건당 댓글 최대 수집 개수
NEWS_MAX_COMMENTS_PER_ARTICLE=30

# 댓글 수집 샘플링 비율(0.0~1.0)
# 0.2면 언론사 x 키워드 별로 20%만 선정해서 얘네들의 댓글만 최대 30개씩 크롤링함
# 예를들어 조선일보의 쿠팡 키워드의 기사가 50개라면 이 중 10개 기사만 선정해서 크롤링함
NEWS_COMMENT_SAMPLE_RATE=0.2

# 댓글 샘플링 시 최소 수집 기사 수(최소 1)
# 예를들어 조선일보의 쿠팡 키워드의 기사가 3개라면 이중 1개 기사의 댓글을 크롤링한다는 뜻
NEWS_COMMENT_SAMPLE_MIN=1

# 댓글을 DB에 저장할 때 한 번에 500개씩 저장
COMMENT_INSERT_BATCH_SIZE=500

# --------------------------------- 3. 전처리 관련 설정 --------------------------------------
# 0이면 "전체 TREND_RUN" 대상
# 어차피 전처리는 시간 별로 안걸리니 0으로 설정
PREPROCESS_TREND_RUN_SEQ=0

# 1이면 refresh 모드(전처리 여부 무관 전체 재생성), 0이면 미전처리(NULL)만
PREPROCESS_REFRESH=0

# 뉴스 기사 전처리 배치 크기 -> 한 번에 기사 300개씩 전처리
PREPROCESS_ARTICLE_BATCH_SIZE=300

# 뉴스 댓글 전처리 배치 크기 -> 한 번에 댓글 500개씩 전처리
PREPROCESS_COMMENT_BATCH_SIZE=500

# 0이면 제한 없음
# 예를들어 기사 수가 2300개 이고, PREPROCESS_ARTICLE_BATCH_SIZE=300 일때 라운드를 3으로 설정하면
# 1라운드 300개, 2라운드 300개, 3라운드 300개로 총 900개의 기사만 전처리하고 나머지 1400개는 전처리 못한채 끝난다. 
# 따라서 항상 0으로 해놔야 모든 데이터가 전처리된다.
PREPROCESS_MAX_ROUNDS=0

# --------------------------------- 4. 기사량 통계 집계(aggregate) 관련 설정 --------------------------------------
# run_aggregate 기본 대상 TREND_RUN_SEQ (0이면 최신 자동)
AGG_TREND_RUN_SEQ=0

# 집계 대상 기간 필터 목록(콤마로 구분)
AGG_PERIODS=TODAY,D7,D14,D30

# 같은 trend_run 재실행 시 기존 집계 삭제 후 재적재 여부(0/1)
# 0이면 삭제 없이 UPSERT(갱신), 1이면 삭제 후 재집계
AGG_REFRESH=1

# 집계 적재(executemany) 청크 크기 -> 한 번에 800개씩 실행
AGG_INSERT_CHUNK_SIZE=800

# --------------------------------- 5. 최종 순위 집계(run_final_rank) 관련 설정 --------------------------------------
# run_final_rank 기본 대상 TREND_RUN_SEQ (0이면 최신 자동)
FINAL_RANK_TREND_RUN_SEQ=0

# 집계 대상 기간 필터 목록(콤마 구분)
# 이건 시간 얼마 안걸리므로 전부 다 함
FINAL_RANK_PERIODS=TODAY,D7,D14,D30

# 같은 trend_run 재실행 시 기존 최종순위 삭제 후 재적재 여부(0/1)
# 0이면 삭제 없이 UPSERT(갱신), 1이면 삭제 후 재집계
FINAL_RANK_REFRESH=1

# 영문-only 키워드 허용 목록(콤마 구분, 소문자 권장)
KEYWORD_ENGLISH_WHITELIST=chat gpt,chatgpt,gpt

# --------------------------------- 6. AI 요약 관련 설정 --------------------------------------
# OpenAI 호출할 때 쓰는 모델 이름
AI_SUMMARY_MODEL=gpt-4o-mini

# system 메시지(LLM의 역할/톤 지정)
AI_SUMMARY_SYSTEM_PROMPT=너는 한국어 뉴스 요약 전문가다. 출력은 반드시 한국어로 한다.

# user 프롬프트 템플릿(치환 변수)
# {keyword_name}, {start_date}, {end_date}, {articles_block} 를 코드에서 채워 넣는다.
# 현재 기사의 기간은 D7에서 최신순으로 선택 -> 이걸로 언론사, 기간 상관없이 전부 동일하게 보여줄 예정
AI_SUMMARY_USER_PROMPT_TEMPLATE=너는 뉴스 요약 전문가다.\n키워드: {keyword_name}\n\n아래는 여러 언론사 기사 제목/본문(일부)이다. 중복을 제거하고 핵심 흐름만 사실 중심으로 요약해라.\n과장하거나 기사에 없는 내용을 추측해 추가하지 마라.\n\n출력 규칙:\n- 번호(1),2),3))나 불릿(-, •)을 사용하지 말고, 문단으로만 작성한다.\n- 전체는 3~4개 문단으로 구성한다.\n- 첫 문단은 전체 흐름을 한두 문장으로 압축한다.\n- 다음 문단(들)은 핵심 전개/원인·영향/주요 쟁점을 자연스러운 서술로 정리한다.\n- 고유명사(기관/인물/정책/지역)와 날짜·수치는 기사 입력에 등장한 범위에서만 사용한다.\n\n기사 입력:\n{articles_block}

# run_summary 기본 대상 TREND_RUN_SEQ (0이면 최신 자동)
SUMMARY_TREND_RUN_SEQ=0

# 같은 trend_run 재실행 시 기존 요약/매핑 삭제 후 재생성 여부(0/1)
# 0이면 삭제 없이 UPSERT(갱신), 1이면 삭제 후 재집계
SUMMARY_REFRESH=1

# 요약의 창의성/랜덤성
AI_SUMMARY_TEMPERATURE=0.2

# 모델이 최대 몇 토큰까지 출력할지 제한 -> 600 토큰이면 한국어 기준 대략 900 ~ 1500자 안팎
AI_SUMMARY_MAX_OUTPUT_TOKENS=600

# AI 요약에 사용할 키워드 상위 N개 -> 현재는 구글 트렌드 순위 기준. 추후 최종 순위 집계대로 재정렬 필요. 
# 0이면 전체 키워드 전부 분석 실행
AI_SUMMARY_KEYWORD_TOP_N=0

# 키워드별로 기사 몇 개를 뽑아 입력으로 줄지
# 각 언론사마다 키워드 당 1개씩 기사 선정해서 요약 돌림 -> 언론사가 총 9개니까 최종적으로 9개를 뽑음
AI_SUMMARY_PER_MEDIA_LIMIT=1

# 한 키워드에 대해 선정된 기사 수가 최소 1개 미만이면 요약 스킵
AI_SUMMARY_MIN_ARTICLES=1

# LLM에 넣을 CONTENT_CLEAN 길이가 300자 미만인 기사는 아예 제외
AI_SUMMARY_CONTENT_MIN_CHARS=300

# LLM에 넣을 CONTENT_CLEAN를 최대 1200자까지만 잘라서 넣는다
AI_SUMMARY_CONTENT_CLIP_MAX=1200

# Hugging Face 다운로드 이슈 회피(네트워크 불안정 시)
HF_HUB_DISABLE_XET=1
HF_HUB_DOWNLOAD_TIMEOUT=60
HF_HUB_ETAG_TIMEOUT=60
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# --------------------------------- 7. Transformers(허깅페이스) 모델로 돌리는 <제목 감성 분석> 관련 설정 --------------------------------------
# 감성분석 모델을 CPU로 실행
SENTIMENT_TITLE_DEVICE=cpu

# 사용할 모델 이름
SENTIMENT_TITLE_MODEL_NAME=snunlp/KR-FinBert-SC

# 감성분석에 사용할 키워드 상위 N개 -> 구글 트렌드 순위 기준
# 0이면 이번 run의 모든 키워드를 대상으로 분석한다는 의미
SENTIMENT_TITLE_KEYWORD_TOP_N=0

# 키워드×언론사(전체 제외) 그룹 최소 기사 수 (미만이면 스킵)
# 예를들어 SENTIMENT_TITLE_MIN_ARTICLES_PER_GROUP=6 일때 조선일보의 쿠팡 키워드의 기사가 4개면 조선일보 분석은 스킵
# 또한 조선일보의 쿠팡 키워드의 TODAY 기사 수는 4개인데, D7 기사 수는 7개라면 TDOAY 결과는 적재가 안되고, D7 결과만 적재된다.
# 기사 수 기준은 "각 기간(TODAY/D7/D14/D30)별로 조회된 기사 수"이다.
# 0이면 스킵 규칙 적용 x
SENTIMENT_TITLE_MIN_ARTICLES_PER_GROUP=0

# 키워드×전체 그룹 최소 기사 수 (미만이면 스킵)
# 비우거나 0이면 전체 그룹은 스킵 규칙 적용 안 함
SENTIMENT_TITLE_MIN_ARTICLES_OVERALL=0

# 0이면 최신 TREND_RUN_SEQ 자동
SENTIMENT_TITLE_TREND_RUN_SEQ=0

# 실행 대상 기간 필터 목록(콤마 구분) 예: TODAY,D7,D14,D30
SENTIMENT_TITLE_PERIODS=D7,D14

# 같은 trend_run 재실행 시 기존 TITLE 감성 컬럼만 0으로 초기화(UPDATE) 후 재적재 여부(0/1)
# 0이면 그대로 UPSERT 갱신, 1이면 TITLE 감성 컬럼만 0으로 초기화(UPDATE) 후 재적재 (DELETE 아님)
SENTIMENT_TITLE_REFRESH=1

# 감성분석 모델에 넣을 토큰 최대 길이 -> 제목은 짧으니 128 정도면 충분. 너무 길면 자동으로 잘려 들어감
SENTIMENT_TITLE_MAX_LENGTH=128

# 한 번에 모델에 밀어 넣는 입력 개수 -> 제목은 짧아서 64여도 괜찮음
SENTIMENT_TITLE_BATCH_SIZE=64

# --------------------------------- 8. Transformers(허깅페이스) 모델로 돌리는 <본문 감성 분석> 관련 설정 --------------------------------------
# 감성분석 모델을 CPU로 실행
SENTIMENT_CONTENT_DEVICE=cpu

# 사용할 모델 이름
SENTIMENT_CONTENT_MODEL_NAME=snunlp/KR-FinBert-SC

# 감성분석에 사용할 키워드 상위 N개 -> 구글 트렌드 순위 기준
# 0이면 이번 run의 모든 키워드를 대상으로 분석한다는 의미
SENTIMENT_CONTENT_KEYWORD_TOP_N=0

# 키워드×언론사(전체 제외) 그룹 최소 기사 수 (미만이면 스킵)
# 0이면 스킵 규칙 적용 x
SENTIMENT_CONTENT_MIN_ARTICLES_PER_GROUP=0

# 키워드×전체 그룹 최소 기사 수 (미만이면 스킵)
# 비우거나 0이면 전체 그룹은 스킵 규칙 적용 안 함
SENTIMENT_CONTENT_MIN_ARTICLES_OVERALL=0

# run_content_sentiment 기본 대상 TREND_RUN_SEQ (0이면 최신 자동)
SENTIMENT_CONTENT_TREND_RUN_SEQ=0

# 실행 대상 기간 필터 목록(콤마 구분)
# 시간이 너무 오래걸려서 안쓰이는 TODAY, D30은 삭제함
SENTIMENT_CONTENT_PERIODS=D7,D14

# 같은 trend_run 재실행 시 기존 본문 감성 컬럼만 0으로 초기화(UPDATE) 후 재적재 여부(0/1)
# 0이면 그대로 UPSERT 갱신, 1이면 CONTENT 감성 컬럼만 0으로 초기화(UPDATE) 후 재적재 (DELETE 아님)
SENTIMENT_CONTENT_REFRESH=1

# 감성분석 모델에 넣을 토큰 최대 길이 -> 본문은 더 길기 때문에 제목보다 더 여유있게 잡음
SENTIMENT_CONTENT_MAX_LENGTH=256

# 한 번에 모델에 밀어 넣는 입력 개수 -> 본문은 입력이 길고 무거워서, 제목보다 배치를 더 작게 잡음
SENTIMENT_CONTENT_BATCH_SIZE=16

# 본문을 1200자 단위로 잘라서 각각 감성분석 한다는 뜻 
SENTIMENT_CONTENT_CHUNK_SIZE_CHARS=1200

# 청크를 자를 때 앞뒤로 200자 겹치게(overlap) 자름
# 문장이 청크 경계에서 잘리면 의미가 깨져서 감성 분류가 흔들릴 수 있음
# 겹치게 하면 문맥 손실이 줄어듦(대신 계산량은 증가)
SENTIMENT_CONTENT_CHUNK_OVERLAP_CHARS=200

# 한 기사에서 최대 청크를 6개까지만 분석
SENTIMENT_CONTENT_MAX_CHUNKS=6

# 본문 정제 후 길이가 200자 미만이면 분석에서 제외
SENTIMENT_CONTENT_MIN_CHARS=200

# --------------------------------- 9. 제목 편향도(run_title_bias) 관련 설정 --------------------------------------
# (참고) 편향도는 감성분석 결과를 사용하므로, 기사 수 최소 기준은 감성분석 단계에서 이미 반영된다.
# run_title_bias 기본 대상 TREND_RUN_SEQ (0이면 최신 자동)
BIAS_TITLE_TREND_RUN_SEQ=0

# 실행 대상 기간 필터 목록(콤마로 구분)
BIAS_TITLE_PERIODS=D7,D14

# 같은 trend_run 재실행 시 기존 TITLE 편향 컬럼만 0으로 초기화(UPDATE) 후 재적재 여부(0/1)
# 0이면 그대로 갱신(UPSERT), 1이면 초기화 후 재적재 (DELETE 아님)
BIAS_TITLE_REFRESH=1

# 제목 편향도 점수의 delta 스케일 계수
BIAS_TITLE_DELTA_SCALE=15.0

# --------------------------------- 10. 본문 편향도(run_content_bias) 관련 설정 --------------------------------------
# (참고) 편향도는 감성분석 결과를 사용하므로, 기사 수 최소 기준은 감성분석 단계에서 이미 반영된다.
# run_content_bias 기본 대상 TREND_RUN_SEQ (0이면 최신 자동)
BIAS_CONTENT_TREND_RUN_SEQ=0

# 실행 대상 기간 필터 목록(콤마로 구분)
BIAS_CONTENT_PERIODS=D7,D14

# 같은 trend_run 재실행 시 기존 CONTENT 편향 컬럼만 0으로 초기화(UPDATE) 후 재적재 여부(0/1)
# 0이면 그대로 갱신(UPSERT), 1이면 초기화 후 재적재 (DELETE 아님)
BIAS_CONTENT_REFRESH=1

# 본문 편향도 점수의 delta 스케일 계수
# score = clamp(delta_net * BIAS_CONTENT_DELTA_SCALE, -10, +10)
BIAS_CONTENT_DELTA_SCALE=15.0

# --------------------------------- 11. 워드클라우드(run_wordcloud) 관련 설정 --------------------------------------
# 워드클라우드 대상 키워드 상위 N개 (0이면 이번 run의 전체 키워드)
WORDCLOUD_TOP_N=0

# 입력 텍스트 최소 길이 컷(CHAR_LENGTH 기준)
WORDCLOUD_TEXT_MIN_CHARS_TITLE=2
WORDCLOUD_TEXT_MIN_CHARS_CONTENT=200
WORDCLOUD_TEXT_MIN_CHARS_COMMENT=5

# 그룹당 입력 텍스트 최대 개수 제한 (0이면 제한 없음)
WORDCLOUD_LIMIT_ROWS_TITLE=0
WORDCLOUD_LIMIT_ROWS_CONTENT=0
WORDCLOUD_LIMIT_ROWS_COMMENT=0

# 영문 소문자화 (1=사용, 0=미사용)
WORDCLOUD_PRE_LOWERCASE_ENGLISH=1

# 반복 문자 축약(ㅋㅋㅋㅋ/ㅎㅎㅎㅎ/aaaa 등) (1=사용, 0=미사용)
WORDCLOUD_PRE_NORMALIZE_REPEATS=1

# 너무 긴 텍스트 길이 상한(0이면 제한 없음)
WORDCLOUD_PRE_MAX_LEN=5000

# 토큰 최소 길이(기본 2)
WORDCLOUD_TOKEN_MIN_LEN=2

# 토큰 최대 길이(기본 30)
WORDCLOUD_TOKEN_MAX_LEN=30

# 숫자만 있는 토큰 제거(1=제거, 0=유지)
WORDCLOUD_DROP_NUMERIC_ONLY=1

# 불용어: 콤마 구분 문자열(예: "이,그,저,및,관련,기자,뉴스")
# 비우면 미사용
WORDCLOUD_STOPWORDS_CSV=

# 불용어 파일 경로(상대경로는 프로젝트 루트 기준)
# 비우면 미사용
WORDCLOUD_STOPWORDS_FILE=./src/analyzer/wordcloud/stopwords.txt

# 워드클라우드 결과로 뽑을 단어 개수 상위 K
# 언론사x키워드x기간 필터x타입 당 60개씩 순위가 뽑힌다.
WORDCLOUD_TOP_K=60

# 가중치 계산 방식: log | count
# log: log(1+count)로 큰 빈도 쏠림 완화(추천)
# count: count 그대로
WORDCLOUD_WEIGHT_MODE=log

# run_wordcloud 기본 대상 TREND_RUN_SEQ (0이면 최신 자동)
WORDCLOUD_TREND_RUN_SEQ=0

# 실행 대상 기간 필터 목록(콤마 구분) 예: TODAY,D7,D14,D30
WORDCLOUD_PERIODS=D7,D14

# 실행 대상 타입 목록(콤마 구분) 예: TITLE,CONTENT,COMMENT
WORDCLOUD_TYPES=TITLE,CONTENT,COMMENT

# 같은 run 재실행 시 기존 결과 처리(0/1)
# 0이면 기존 결과가 있으면 스킵(또는 갱신 정책은 코드 설정에 따름)
# 1이면 기존 결과가 있어도 재계산해서 덮어쓴다
WORDCLOUD_REFRESH=1

# 워드클라우드 대상 media_code 목록(콤마로 구분)
# 0만 넣으면 "전체(통합)"만 생성
# 여러 개 넣으면 각 언론사별 + (0 포함 시) 통합도 생성
WORDCLOUD_MEDIA_CODES=0,1023,1025,1020,1028,1032,1002,1469,1081,1001


# --------------------------------- 12. 공동언급네트워크(run_cooc_network) 관련 설정 --------------------------------------
# 공동언급 네트워크 실행 옵션
COOC_TREND_RUN_SEQ=0
COOC_PERIODS=D7,D14
COOC_KEYWORD_TOP_N=0
COOC_REFRESH=0

# 텍스트 소스: TITLE | CONTENT | BOTH
COOC_TEXT_SOURCE=CONTENT

# DB 조회 단계에서 텍스트 최소 길이 컷(CHAR_LENGTH 기준)
COOC_MIN_TEXT_CHARS=120

# 전처리(반복/공백/영문 소문자화)
COOC_PRE_LOWERCASE_ENGLISH=1
COOC_PRE_NORMALIZE_REPEATS=1
COOC_PRE_MAX_LEN=5000

# 토큰화 + 불용어
COOC_TOKEN_MIN_LEN=2
COOC_TOKEN_MAX_LEN=30
COOC_DROP_NUMERIC_ONLY=1
COOC_STOPWORDS_CSV=그리고,하지만,때문에,관련,대한,기자,뉴스,속보
COOC_STOPWORDS_FILE=./src/analyzer/wordcloud/stopwords.txt

# 네트워크 생성 모드: doc | window
COOC_MODE=doc
COOC_WINDOW_SIZE=20

# 안전장치/출력 제한
COOC_MAX_TOKENS_PER_DOC=30
COOC_NODE_TOP_K=20
COOC_EDGE_TOP_K=60
COOC_MIN_EDGE_WEIGHT=2

# 최소 문서 수 제한
# 기사 수가 5건 미만인 경우 공동 언급 네트워크 결과는 저장되지 않는다.
COOC_MIN_DOCS_USED=5


# --------------------------------- 13. 네이버 데이터랩 타임라인 분석 --------------------------------------
# cooc_network 다음, run_all 순서의 마지막 단계에서 실행
SEARCH_TIMELINE_TREND_RUN_SEQ=0
SEARCH_TIMELINE_KEYWORD_TOP_N=0
SEARCH_TIMELINE_BATCH_SIZE=0
SEARCH_TIMELINE_REFRESH=1
SEARCH_TIMELINE_TIMEFRAME=today 3-m

NAVER_DATALAB_DEVICE=
NAVER_DATALAB_GENDER=
NAVER_DATALAB_AGES=

NAVER_DATALAB_REQUEST_TIMEOUT_SECONDS=20
SEARCH_TIMELINE_SLEEP_MIN_SECONDS=0.2
SEARCH_TIMELINE_SLEEP_MAX_SECONDS=0.5


# --------------------------------- 14. 전체 파이프라인 실행(run_all) 관련 설정 --------------------------------------
# 실행할 스텝 목록(콤마 구분) - 순서대로 실행됨
# 요청사항 반영: search_timeline은 cooc_network 다음, 마지막 단계에서 실행
# 기본값: RUN_ALL_STEPS=trend,news,preprocess,aggregate,final_rank,summary,title_sentiment,content_sentiment,title_bias,content_bias,wordcloud,cooc_network,search_timeline
RUN_ALL_STEPS=trend,news,preprocess,aggregate,final_rank,summary,title_sentiment,content_sentiment,title_bias,content_bias,wordcloud,cooc_network,search_timeline

# 1이면 중간에 실패하면 즉시 중단, 0이면 실패해도 다음 스텝 계속
RUN_ALL_FAIL_FAST=1
